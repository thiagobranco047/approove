# SQLite local — usado pelo Prisma CLI (migrate, db push)
DATABASE_URL="file:./prisma/dev.db"

# Turso (produção / runtime da aplicação)
# Fora de produção o app recusa banco remoto; ALLOW_REMOTE_DB=1 libera conscientemente.
TURSO_DATABASE_URL="libsql://seu-database.turso.io"
TURSO_AUTH_TOKEN=""
ALLOW_REMOTE_DB=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-um-secret-com-openssl-rand-base64-32"
# Em produção (Vercel) use também AUTH_SECRET com o mesmo valor e AUTH_TRUST_HOST=true
AUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URIs: http://localhost:3000/api/auth/callback/google
#                https://approoveapp.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob (para upload de imagens - https://vercel.com/dashboard/stores)
BLOB_READ_WRITE_TOKEN=""

# E-mail transacional (Resend - https://resend.com/api-keys)
# Necessário para enviar convites de revisor automaticamente no piloto.
RESEND_API_KEY=""
EMAIL_FROM="Approove <convites@seudominio.com>"

# Stripe Billing (produção deve usar sk_live_... / price_ live)
STRIPE_SECRET_KEY=""
STRIPE_SECRET_KEY_LIVE=""
# Só em preview/dev. Produção recusa sk_test_ a menos que isto seja true.
STRIPE_ALLOW_TEST_MODE=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_STUDIO=""
# IDs antigos, só para mapear assinaturas grandfathered depois de criar Prices novos
STRIPE_PRICE_SOLO_LEGACY=""
STRIPE_PRICE_STARTER_LEGACY=""
STRIPE_PRICE_PRO_LEGACY=""
STRIPE_PRICE_STUDIO_LEGACY=""
STRIPE_PORTAL_CONFIGURATION_ID=""
# Produção (VERCEL_ENV=production) recusa sk_test_. "true" libera de propósito (homologação).
STRIPE_ALLOW_TEST_MODE=""

# URL pública da aplicação (obrigatório em produção para links em e-mails)
# NEXTAUTH_URL="https://app.seudominio.com"

# Google Analytics 4 (obrigatório em produção para habilitar o tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-7CXF7VPWDZ"
